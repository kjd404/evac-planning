package(default_visibility = ["//visibility:public"])

genrule(
    name = "bison_gen",
    srcs = ["src/parser.y"],
    outs = ["parser.tab.c", "parser.tab.h"],
    cmd = "bison -d -o $(@D)/parser.tab.c $(location src/parser.y)",
)

genrule(
    name = "flex_gen",
    srcs = ["src/lexer.l"],
    outs = ["lex.yy.c"],
    cmd = "flex -o $(@D)/lex.yy.c $(location src/lexer.l)",
)

cc_library(
    name = "parser_lib",
    srcs = [":parser.tab.c"],
    hdrs = glob(["include/*.h"]) + [":parser.tab.h"],
    copts = [
        "-x", "c++",
        "-ISimulation/include", "-ISimulation",
    ],
    includes = ["include", "."],
)

cc_library(
    name = "evac_lib",
    srcs = glob(["src/*.cpp"], exclude=["src/sim.cpp", "src/spec.cpp"]),
    hdrs = glob(["include/*.h"]),
    copts = [
        "-std=c++11",
        "-ISimulation/include",
        "-ISimulation",
    ],
    includes = [
        "include",
    ],
    linkopts = [
        "-pthread",
        "-lm",
    ],
    deps = [],
)

cc_binary(
    name = "evac",
    srcs = [
        ":lex.yy.c",
        "src/sim.cpp",
        "src/spec.cpp",
    ],
    copts = [
        "-std=c++11",
        "-x",
        "c++",  # Treat .c Bison/Flex outputs as C++ like the original Makefile did via g++
        "-ISimulation/include",
        "-ISimulation",
    ],
    deps = [":evac_lib", ":parser_lib"],
    linkopts = [
        "-pthread",
        "-lm",
    ],
)

# A simple run wrapper that ensures an 'outputs/' directory exists before
# invoking the simulator. Pass the scenario file path as arguments.
sh_binary(
    name = "evac_run",
    srcs = ["run_evacuate.sh"],
    data = [":evac"],
)

sh_test(
    name = "evac_minigrid_it",
    srcs = ["test_e2e_minigrid.sh"],
    data = [
        ":evac",
        "slang/minigrid.slang",
    ],
)

py_binary(
    name = "viz_gif",
    srcs = ["tools/viz_gif.py"],
)

sh_binary(
    name = "evac_viz_run",
    srcs = ["run_viz.sh"],
    data = [
        ":evac",
        ":viz_gif",
    ],
)

# Hermetic drawable and GIF rules (Starlark)
load("//Simulation:sim_rules.bzl", "run_sim_drawable", "make_gif")

# Idiomatic hermetic build of drawable and GIF as Bazel outputs for a specific scenario.
# Highway scenario: drawable (highwayFinal.txt) and animated GIF (highway_anim.gif)
run_sim_drawable(
    name = "drawable_highway",
    scenario = "slang/highway.slang",
    city = "highway",
    out = "highwayFinal.txt",
)

make_gif(
    name = "gif_highway",
    drawable = ":drawable_highway",
    out = "highway_anim.gif",
    width = 700,
    fps = 30,
    duration = "10",
    edgewidth = "prob",
    trails = True,
)

# Minigrid scenario: drawable and GIF
run_sim_drawable(
    name = "drawable_minigrid",
    scenario = "slang/minigrid.slang",
    city = "minigrid",
    out = "minigridFinal.txt",
)

make_gif(
    name = "gif_minigrid",
    drawable = ":drawable_minigrid",
    out = "minigrid_anim.gif",
    width = 700,
    fps = 30,
    duration = "10",
    edgewidth = "prob",
    trails = True,
)
