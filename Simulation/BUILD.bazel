package(default_visibility = ["//visibility:public"])

genrule(
    name = "bison_gen",
    srcs = ["src/parser.y"],
    outs = ["parser.tab.c", "parser.tab.h"],
    cmd = "bison -d -o $(@D)/parser.tab.c $(location src/parser.y)",
)

genrule(
    name = "flex_gen",
    srcs = ["src/lexer.l"],
    outs = ["lex.yy.c"],
    cmd = "flex -o $(@D)/lex.yy.c $(location src/lexer.l)",
)

cc_library(
    name = "parser_lib",
    srcs = [":parser.tab.c"],
    hdrs = glob(["include/*.h"]) + [":parser.tab.h"],
    copts = [
        "-x", "c++",
        "-ISimulation/include", "-ISimulation",
    ],
    includes = ["include", "."],
)

cc_library(
    name = "evac_lib",
    srcs = glob(["src/*.cpp"], exclude=["src/sim.cpp", "src/spec.cpp"]),
    hdrs = glob(["include/*.h"]),
    copts = [
        "-std=c++11",
        "-ISimulation/include",
        "-ISimulation",
    ],
    includes = [
        "include",
    ],
    linkopts = [
        "-pthread",
        "-lm",
    ],
    deps = [],
)

cc_binary(
    name = "evac",
    srcs = [
        ":lex.yy.c",
        "src/sim.cpp",
        "src/spec.cpp",
    ],
    copts = [
        "-std=c++11",
        "-x",
        "c++",  # Treat .c Bison/Flex outputs as C++ like the original Makefile did via g++
        "-ISimulation/include",
        "-ISimulation",
    ],
    deps = [":evac_lib", ":parser_lib"],
    linkopts = [
        "-pthread",
        "-lm",
    ],
)

# A simple run wrapper that ensures an 'outputs/' directory exists before
# invoking the simulator. Pass the scenario file path as arguments.
sh_binary(
    name = "evac_run",
    srcs = ["run_evacuate.sh"],
    data = [":evac"],
)

sh_test(
    name = "evac_minigrid_it",
    srcs = ["test_e2e_minigrid.sh"],
    data = [
        ":evac",
        "slang/minigrid.slang",
    ],
)
